(defun shapes-demo ()
  "Browse shapes with Left and Right. Press Space to switch dimensions."
  (let* ((flat (flat-shape-examples))
         (solid (solid-shape-examples))
         (examples flat)
         (index 0)
         (camera (camera-3d :position (vec3 4 3 6) :target (vec3 0 0 0)))
         (paper (color 245 245 245))
         (ink (color 30 35 45)))
    (init-window 720 440 "Raylib shapes")
    (unwind-protect
         (progn
           (set-target-fps 60)
           (loop until (window-should-close-p)
                 do (when (key-pressed-p :space)
                      (setf examples (if (eq examples flat) solid flat)
                            index 0))
                    (when (key-pressed-p :right)
                      (setf index (mod (1+ index) (length examples))))
                    (when (key-pressed-p :left)
                      (setf index (mod (1- index) (length examples))))
                    (destructuring-bind (name draw) (nth index examples)
                      (begin-drawing)
                      (clear-background paper)
                      (when (eq examples solid) (begin-mode-3d camera))
                      (funcall draw)
                      (when (eq examples solid) (end-mode-3d))
                      (draw-text name 20 20 28 ink)
                      (draw-text (format nil "~A  ~D/~D    Left/Right: browse    Space: 2D/3D    Esc: exit"
                                         (if (eq examples flat) "2D" "3D")
                                         (1+ index) (length examples))
                                 20 400 18 ink)
                      (end-drawing))))
      (close-window))))
