(defpackage #:raylisp/tests
  (:use #:cl)
  (:export #:run #:check-macros))

(in-package #:raylisp/tests)

(defun run ()
  ;; All these checks run without opening a window or using a controller.
  (unless (cffi:foreign-symbol-pointer "InitWindow") (raylisp:load-raylib))
  (loop for area in '(:core :shapes-2d :fonts :shapes-3d :controllers)
        for expected in '(211 75 59 73 2)
        for entries = (raylisp::lesson-entries area)
        do (assert (= expected (length entries)))
           (loop for (call prototype description example) in entries
                 for end = (position #\( prototype)
                 for start = (position-if-not #'alphanumericp prototype :from-end t :end end)
                 for c-name = (subseq prototype (1+ start) end)
                 for lisp-name = (subseq call 1 (position-if (lambda (c) (find c " )")) call))
                 do (assert (plusp (length description)))
                    (assert (cffi:foreign-symbol-pointer c-name) () "Missing ~A" c-name)
                    (multiple-value-bind (symbol status)
                        (find-symbol (string-upcase lisp-name) :raylisp)
                      (assert (and (eq status :external) (fboundp symbol)) () "~A" call)
                      ;; Every usage example must be one readable Lisp call.
                      (let ((*package* (find-package :raylisp)) (*read-eval* nil))
                        (multiple-value-bind (form end) (read-from-string example)
                          (assert (= end (length example)))
                          (assert (eq symbol (first form)) () "~A" example))))))
  ;; Both truth values must cross the C ABI when structures are passed by value.
  (let ((box (raylisp:rectangle 0 0 2 2)))
    (assert (raylisp:check-collision-recs box box))
    (assert (not (raylisp:check-collision-recs box (raylisp:rectangle 8 8 1 1)))))
  (let* ((ray (raylisp:ray (raylisp:vec3 0 0 4) (raylisp:vec3 0 0 -1)))
         (box (raylisp:bounding-box (raylisp:vec3 -1 -1 -1) (raylisp:vec3 1 1 1)))
         (hit (raylisp:get-ray-collision-box ray box)))
    (assert (raylisp:struct-field hit :hit))
    (assert (= 3 (raylisp:struct-field hit :distance))))
  (assert (equal '(65 955) (raylisp:font-codepoints "Aλ")))
  (assert (string= "42" (raylisp:text-format "%d" :int 42)))
  (cffi:with-foreign-object (camera '(:struct raylisp:camera-3d))
    (setf (cffi:mem-ref camera '(:struct raylisp:camera-3d))
          (raylisp:camera-3d :position (raylisp:vec3 0 0 4) :target (raylisp:vec3 0 0 0)))
    (raylisp:update-camera-pro camera (raylisp:vec3 1 0 0) (raylisp:vec3 0 0 0) 0f0)
    (let ((position (raylisp:struct-field (cffi:mem-ref camera '(:struct raylisp:camera-3d))
                                           :position)))
      (assert (= 3 (raylisp:struct-field position :z)))))
  t)
