(in-package #:raylisp/tests)

(defun check-macros ()
  ;; A place can run code while locating its value. Run that code once.
  (let* ((original (raylisp:vec2 10 20))
         (points (vector original))
         (i -1))
    (raylisp:move-point-by (aref points (incf i)) 2 3)
    (assert (= i 0))
    (assert (= 10 (raylisp:struct-field original :x)))
    (raylisp:with-point-components (x y) (aref points 0)
      (assert (= x 12))
      (incf y 5))
    (assert (= 28 (raylisp:struct-field (aref points 0) :y))))
  (let ((events (list :left :right nil)))
    (flet ((raylisp:next-key-pressed () (pop events)))
      (let ((seen nil))
        (raylisp:do-pressed-keys (key) (push key seen))
        (assert (equal (reverse seen) '(:left :right))))))
  (let ((calls nil))
    (flet ((raylisp:begin-mode-3d (camera) (push camera calls))
           (raylisp:end-mode-3d () (push :end calls)))
      (catch 'stop (raylisp:with-3d (:camera) (throw 'stop nil)))
      (assert (equal calls '(:end :camera)))))
  (let ((released nil) (path-reads 0))
    (flet ((raylisp:get-font-default () :borrowed)
           (raylisp:load-font-ex (path size codes count)
             (declare (ignore path size codes count)) :owned)
           (raylisp:is-font-valid (font) (member font '(:owned :borrowed)))
           (raylisp:unload-font (font) (push font released)))
      (assert (eq :borrowed (raylisp:with-font (font) font)))
      (catch 'stop
        (raylisp:with-font (font (progn (incf path-reads) "title.ttf"))
          (assert (eq font :owned))
          (throw 'stop nil)))
      (assert (= path-reads 1))
      (assert (equal released '(:owned)))))
  (macrolet ((local-move () '(incf x 2)))
    (assert (equal (raylisp:expansion-of (local-move)) '(incf x 2))))
  (dolist (entry raylisp::*macro-examples*)
    (assert (plusp (length (with-output-to-string (out)
                             (raylisp:macro-guide (first entry) out)))))))
